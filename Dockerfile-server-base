# Dockerfile-server-base
# Base image containing system dependencies and Python packages
FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends libopus0 ffmpeg locales && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Configure pip timeout and retries (default PyPI index)
RUN pip config set global.timeout 120 && \
    pip config set install.retries 5

# Set environment variables to ensure proper character encoding
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    PYTHONIOENCODING=utf-8

WORKDIR /opt/xiaozhi-esp32-server

# Copy requirements.txt
COPY main/xiaozhi-server/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    # 阿里云 PyPI 镜像偶有元数据 404，加官方源作 fallback
    pip install --no-cache-dir -r requirements.txt --default-timeout=120 --retries 5 --extra-index-url https://pypi.org/simple