# ==========================================================
# Xiaozhi ESP32 Server - Port Configuration
# ==========================================================
# Copy this file to .env before starting Docker:
#   cp .env.example .env
#
# Change these ports to any available ports on your host server
# ==========================================================

WEB_PORT=18002        # Web Management Console & REST API (e.g. 18002, 28002, 9002)
WS_PORT=18000         # Python AI WebSocket Server for ESP32 (e.g. 18000, 28000, 9000)
VISION_PORT=18003     # MCP & Vision Analysis Endpoint (e.g. 18003, 28003, 9003)

# ==========================================================
# Manager API Secret
# (Register first account at http://IP:18002 -> Parameter Management -> server.secret)
# ==========================================================
MANAGER_API_SECRET=

# ==========================================================
# MQTT Gateway Configuration (Online Devices & Asset Flashing)
# ==========================================================
MQTT_PUBLIC_IP=                  # Your server Public IP (or DNS-only subdomain e.g. mqtt.czbd.app)
MQTT_PORT=1883                   # MQTT TCP Port (ESP32 connects here)
UDP_PORT=8884                    # UDP Port
MQTT_API_PORT=8007               # Management API Port (Java console communicates here)
MQTT_SIGNATURE_KEY=SecureEspMqttKey2026

# ==========================================================
# Voiceprint Recognition Configuration (3D-Speaker)
# ==========================================================
VOICEPRINT_PORT=18005            # Voiceprint API Host Port
VOICEPRINT_KEY=7a8b9c0d-1e2f-4a5b-8c9d-0e1f2a3b4c5d
