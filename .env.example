# ==========================================================
# Xiaozhi ESP32 Server - Port Configuration
# ==========================================================
# Copy this file to .env before starting Docker:
#   cp .env.example .env
#
# Change these ports to any available ports on your host server
# ==========================================================

WEB_PORT=18002        # Web Management Console & REST API (e.g. 18002, 28002, 9002)
WS_PORT=18000         # Python AI WebSocket Server for ESP32 (e.g. 18000, 28000, 9000)
VISION_PORT=18003     # MCP & Vision Analysis Endpoint (e.g. 18003, 28003, 9003)
