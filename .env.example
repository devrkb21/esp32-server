# ==========================================================
# Xiaozhi ESP32 Server - Port Configuration
# ==========================================================
# Copy this file to .env before starting Docker:
#   cp .env.example .env
#
# Change these ports to any available ports on your host server
# ==========================================================

SERVER_DOMAIN=esp.czbd.app   # Server Domain for Web UI (e.g. esp.czbd.app)
WEB_PORT=18002        # Web Management Console & REST API (e.g. 18002, 28002, 9002)
WS_PORT=18000         # Python AI WebSocket Server for ESP32 (e.g. 18000, 28000, 9000)
VISION_PORT=18003     # MCP & Vision Analysis Endpoint (e.g. 18003, 28003, 9003)

# ==========================================================
# Secrets (REQUIRED, never commit real values)
# Generate each with:  openssl rand -hex 32
# MANAGER_API_SECRET is copied into sys_params server.secret on startup, and
# MQTT_SIGNATURE_KEY into server.mqtt_signature_key, so changing them here and
# restarting rotates them everywhere (devices get new MQTT credentials at their
# next OTA check-in).
# ==========================================================
MANAGER_API_SECRET=

# ==========================================================
# MQTT Gateway Configuration (Online Devices & Asset Flashing)
# ==========================================================
MQTT_PUBLIC_IP=                  # Your server Public IP (or DNS-only subdomain e.g. mqtt.czbd.app)
MQTT_PORT=1883                   # MQTT TCP Port (ESP32 connects here)
UDP_PORT=8884                    # UDP Port
MQTT_API_PORT=8007               # Management API port inside the Docker network (not published)
MQTT_SIGNATURE_KEY=               # REQUIRED: openssl rand -hex 32

# ==========================================================
# Voiceprint Recognition Configuration (3D-Speaker)
# ==========================================================
VOICEPRINT_KEY=                  # Must equal server.authorization in main/voiceprint/data/.voiceprint.yaml
