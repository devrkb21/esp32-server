# ==========================================================
# Xiaozhi ESP32 Server - Environment Configuration
# ==========================================================
# Copy this file to .env before starting Docker:
#   cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
# 1. Custom Host Ports
# (Change to any available ports on your host / aaPanel server)
# ----------------------------------------------------------
WEB_PORT=18002        # Web Management Console & API (e.g. 18002, 28002, 9002)
WS_PORT=18000         # Python AI WebSocket Server for ESP32 (e.g. 18000, 28000, 9000)
VISION_PORT=18003     # MCP & Vision Analysis Endpoint (e.g. 18003, 28003, 9003)

# ----------------------------------------------------------
# 2. MySQL Database Settings (Internal to Docker Network)
# ----------------------------------------------------------
# Name of the database to create
DB_NAME=xiaozhi_esp32_server

# Database username (can be 'root' or a custom user e.g. 'xiaozhi')
DB_USER=root

# Database user password
DB_PASSWORD=rootuser

# MySQL Root Administrator Password
MYSQL_ROOT_PASSWORD=rootuser
