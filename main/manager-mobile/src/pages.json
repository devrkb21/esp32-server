{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "Nobix",
    "navigationBarBackgroundColor": "#F7F5F2",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F7F5F2"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^fg-(.*)": "@/components/fg-$1/fg-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "tabBar": {
    "custom": true,
    "color": "#8E857B",
    "selectedColor": "#E2603A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "height": "50px",
    "fontSize": "10px",
    "iconWidth": "24px",
    "spacing": "3px",
    "list": [
      {
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/homeHL.png",
        "pagePath": "pages/index/index",
        "text": "Today",
        "labelKey": "nav.today",
        "icon": "today",
        "iconType": "tb"
      },
      {
        "iconPath": "static/tabbar/example.png",
        "selectedIconPath": "static/tabbar/exampleHL.png",
        "pagePath": "pages/day/index",
        "text": "Day",
        "labelKey": "nav.day",
        "icon": "day",
        "iconType": "tb",
        "needs": "day"
      },
      {
        "iconPath": "static/tabbar/robot.png",
        "selectedIconPath": "static/tabbar/robot_activate.png",
        "pagePath": "pages/look/index",
        "text": "Look",
        "labelKey": "nav.look",
        "icon": "look",
        "iconType": "tb",
        "needs": "look"
      },
      {
        "iconPath": "static/tabbar/system.png",
        "selectedIconPath": "static/tabbar/system_activate.png",
        "pagePath": "pages/settings/index",
        "text": "More",
        "labelKey": "nav.more",
        "icon": "more",
        "iconType": "tb"
      }
    ]
  },
  "pages": [
    {
      "path": "pages/index/index",
      "type": "home",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "Nobix"
      }
    },
    {
      "path": "pages/agent/edit",
      "type": "page",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "Character",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/agent/index",
      "type": "page",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "Character",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/agent/provider",
      "type": "page",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "Fresh information",
        "navigationStyle": "custom"
      }
    },
    {
