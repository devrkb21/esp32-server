VUE_APP_API_BASE_URL=/xiaozhi
# 1. If web console needs to adapt to mobile browser, start manager-api first to get server address (http://lan_ip:8002/xiaozhi)
# 2. In manager-mobile .env, modify VITE_SERVER_BASEURL to your server address, then run pnpm dev:h5 to get h5 page URL, and paste it into VUE_APP_H5_URL below
# 3. Mobile browser accessing web console will redirect to mobile-friendly h5 page
VUE_APP_H5_URL=